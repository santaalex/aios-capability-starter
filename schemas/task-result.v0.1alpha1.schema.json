{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task.aios.fuinno.cn/schemas/task-result.v0.1alpha1.schema.json",
  "title": "AIOS Task Result v0.1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "metadata",
    "status",
    "delivery"
  ],
  "properties": {
    "api_version": {
      "const": "task-result.aios.fuinno.cn/v0.1alpha1"
    },
    "kind": {
      "enum": [
        "CapabilityDevelopmentResult",
        "AdapterDevelopmentResult",
        "DeviceDeploymentResult",
        "DesktopUpdateResult"
      ]
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "CapabilityDevelopmentResult"
          }
        }
      },
      "then": {
        "properties": {
          "delivery": {
            "required": [
              "capability",
              "adapter_required"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "observed_generation",
        "completed_at"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "observed_generation": {
          "type": "integer",
          "minimum": 1
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "summary",
        "conditions"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "COMPLETED",
            "NEEDS_ATTENTION",
            "BLOCKED",
            "FAILED"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "status",
        "reason",
        "message"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "True",
            "False",
            "Unknown"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "validation",
        "known_limitations"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "adapter_required": {
          "type": "boolean"
        },
        "known_limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "version",
        "display_name"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "media_type",
        "location",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "media_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "location": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "dirty",
        "source_manifest",
        "source_manifest_sha256"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dirty": {
          "type": "boolean"
        },
        "source_manifest": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed_checks",
        "declared_required_checks"
      ],
      "properties": {
        "performed_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_RUN"
                ]
              }
            }
          }
        },
        "declared_required_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
