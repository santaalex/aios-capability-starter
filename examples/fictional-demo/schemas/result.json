{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "虚构紧固件批次汇总结果",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "status",
    "message",
    "total_items",
    "total_nominal_length_mm"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "capability_id": {
      "const": "fictional-fastener-summary"
    },
    "status": {
      "const": "COMPLETED"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "total_items": {
      "type": "integer",
      "minimum": 1
    },
    "total_nominal_length_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
